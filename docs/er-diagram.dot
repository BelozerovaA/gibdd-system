digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.55, ranksep=1.5, pad=0.4, fontname="DejaVu Sans", bgcolor="white"];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge  [fontname="DejaVu Sans", fontsize=10, dir=both, color="#222222", arrowsize=0.9];
  departments [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>departments</B><BR/><FONT POINT-SIZE="9">Подразделения</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="name_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="city">city</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(100)</FONT></TD><TD ALIGN="LEFT" PORT="city_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="address_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="phone_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="chief_name">chief_name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(100)</FONT></TD><TD ALIGN="LEFT" PORT="chief_name_r"> </TD></TR></TABLE>>];
  employees [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>employees</B><BR/><FONT POINT-SIZE="9">Сотрудники</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="login">login</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="login_r">UQ NN </TD></TR><TR><TD ALIGN="LEFT" PORT="password">password</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="password_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="full_name_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="birth_date">birth_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="birth_date_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="phone">phone</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="phone_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="email">email</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(100)</FONT></TD><TD ALIGN="LEFT" PORT="email_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="position">position</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(100)</FONT></TD><TD ALIGN="LEFT" PORT="position_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="hire_date">hire_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="hire_date_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="department_id"><I>department_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="department_id_r">FK </TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bool</FONT></TD><TD ALIGN="LEFT" PORT="is_active_r"> </TD></TR></TABLE>>];
  vehicles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>vehicles</B><BR/><FONT POINT-SIZE="9">Автомобили</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="plate">plate</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="plate_r">UQ NN </TD></TR><TR><TD ALIGN="LEFT" PORT="model">model</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(100)</FONT></TD><TD ALIGN="LEFT" PORT="model_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="color">color</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="color_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="vin">vin</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="vin_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="owner_name">owner_name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(100)</FONT></TD><TD ALIGN="LEFT" PORT="owner_name_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="category_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_stolen">is_stolen</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bool</FONT></TD><TD ALIGN="LEFT" PORT="is_stolen_r"> </TD></TR></TABLE>>];
  violation_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>violation_categories</B><BR/><FONT POINT-SIZE="9">Категории нарушений</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="code">code</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="code_r">UQ NN </TD></TR><TR><TD ALIGN="LEFT" PORT="name">name</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="name_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="description">description</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(500)</FONT></TD><TD ALIGN="LEFT" PORT="description_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="fine_amount">fine_amount</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="fine_amount_r"> </TD></TR></TABLE>>];
  wanted_vehicles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>wanted_vehicles</B><BR/><FONT POINT-SIZE="9">Розыск</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_id"><I>vehicle_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="vehicle_id_r">FK NN </TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><I>employee_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="employee_id_r">FK NN </TD></TR><TR><TD ALIGN="LEFT" PORT="violation_category_id"><I>violation_category_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="violation_category_id_r">FK </TD></TR><TR><TD ALIGN="LEFT" PORT="reason">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="reason_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="wanted_date">wanted_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="wanted_date_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="status_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bool</FONT></TD><TD ALIGN="LEFT" PORT="is_active_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="fix_date">fix_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="fix_date_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="fix_time">fix_time</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="fix_time_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="fix_address">fix_address</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="fix_address_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="fix_camera_id">fix_camera_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="fix_camera_id_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="reaction_status">reaction_status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="reaction_status_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="found_status">found_status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="found_status_r"> </TD></TR></TABLE>>];
  cameras [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>cameras</B><BR/><FONT POINT-SIZE="9">Камеры</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="camera_id">camera_id</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="camera_id_r">UQ NN </TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="address_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">float</FONT></TD><TD ALIGN="LEFT" PORT="latitude_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">float</FONT></TD><TD ALIGN="LEFT" PORT="longitude_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="camera_type">camera_type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="camera_type_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="speed_limit">speed_limit</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="speed_limit_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bool</FONT></TD><TD ALIGN="LEFT" PORT="is_active_r"> </TD></TR></TABLE>>];
  alerts [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>alerts</B><BR/><FONT POINT-SIZE="9">Оповещения</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="wanted_id"><I>wanted_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="wanted_id_r">FK NN </TD></TR><TR><TD ALIGN="LEFT" PORT="camera_id"><I>camera_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="camera_id_r">FK </TD></TR><TR><TD ALIGN="LEFT" PORT="vehicle_plate">vehicle_plate</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(20)</FONT></TD><TD ALIGN="LEFT" PORT="vehicle_plate_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="alert_date">alert_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(12)</FONT></TD><TD ALIGN="LEFT" PORT="alert_date_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="alert_time">alert_time</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="alert_time_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="address">address</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="address_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><I>employee_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="employee_id_r">FK </TD></TR><TR><TD ALIGN="LEFT" PORT="is_viewed">is_viewed</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bool</FONT></TD><TD ALIGN="LEFT" PORT="is_viewed_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="reaction_status">reaction_status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="reaction_status_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="found_status">found_status</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="found_status_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="notification_sent">notification_sent</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">bool</FONT></TD><TD ALIGN="LEFT" PORT="notification_sent_r"> </TD></TR></TABLE>>];
  user_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BORDER="1" SIDES="B"><B>user_logs</B><BR/><FONT POINT-SIZE="9">Журнал действий</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="id_r">PK </TD></TR><TR><TD ALIGN="LEFT" PORT="employee_id"><I>employee_id</I></TD><TD ALIGN="LEFT"><FONT COLOR="#444444">int</FONT></TD><TD ALIGN="LEFT" PORT="employee_id_r">FK NN </TD></TR><TR><TD ALIGN="LEFT" PORT="action_type">action_type</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(50)</FONT></TD><TD ALIGN="LEFT" PORT="action_type_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="action_description">action_description</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(255)</FONT></TD><TD ALIGN="LEFT" PORT="action_description_r"> </TD></TR><TR><TD ALIGN="LEFT" PORT="action_date">action_date</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="action_date_r">NN </TD></TR><TR><TD ALIGN="LEFT" PORT="action_time">action_time</TD><TD ALIGN="LEFT"><FONT COLOR="#444444">varchar(10)</FONT></TD><TD ALIGN="LEFT" PORT="action_time_r">NN </TD></TR></TABLE>>];
  departments:id_r:e -> employees:department_id:w [arrowtail=odottee, arrowhead=crowodot, label=" работает в ", labeldistance=2];
  vehicles:id_r:e -> wanted_vehicles:vehicle_id:w [arrowtail=teetee, arrowhead=crowodot, label=" разыскивается ", labeldistance=2];
  employees:id_r:e -> wanted_vehicles:employee_id:w [arrowtail=teetee, arrowhead=crowodot, label=" ведёт розыск ", labeldistance=2];
  violation_categories:id_r:e -> wanted_vehicles:violation_category_id:w [arrowtail=odottee, arrowhead=crowodot, label=" причина розыска ", labeldistance=2];
  wanted_vehicles:id_r:e -> alerts:wanted_id:w [arrowtail=teetee, arrowhead=crowodot, label=" порождает ", labeldistance=2];
  cameras:id_r:e -> alerts:camera_id:w [arrowtail=odottee, arrowhead=crowodot, label=" зафиксировала ", labeldistance=2];
  employees:id_r:e -> alerts:employee_id:w [arrowtail=odottee, arrowhead=crowodot, label=" получает ", labeldistance=2];
  employees:id_r:e -> user_logs:employee_id:w [arrowtail=teetee, arrowhead=crowodot, label=" совершает ", labeldistance=2];
  cameras:id_r:e -> wanted_vehicles:fix_camera_id:w [style=dashed, arrowtail=none, arrowhead=none, color="#666666", fontcolor="#666666", label=" без FK: последняя камера "];
  vehicles:plate_r:e -> alerts:vehicle_plate:w [style=dashed, arrowtail=none, arrowhead=none, color="#666666", fontcolor="#666666", label=" без FK: копия ГРЗ "];
  legend [shape=plain, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><B>Обозначения</B></TD></TR><TR><TD ALIGN="LEFT"><B>жирный</B> PK — первичный ключ</TD></TR><TR><TD ALIGN="LEFT"><I>курсив</I> FK — внешний ключ</TD></TR><TR><TD ALIGN="LEFT">UQ — уникально, NN — обязательно</TD></TR><TR><TD ALIGN="LEFT">«вилка» на линии — сторона «много»</TD></TR><TR><TD ALIGN="LEFT">кружок у родителя — связь необязательна</TD></TR><TR><TD ALIGN="LEFT">пунктир — связь по значению, без FK в БД</TD></TR></TABLE>>];
}