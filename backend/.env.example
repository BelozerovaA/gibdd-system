# Скопируйте этот файл в .env и поправьте значения под себя:  cp .env.example .env
# Файл .env в репозиторий НЕ попадает (см. .gitignore), в нём лежат секреты.

# Подключение к MySQL: mysql+pymysql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/gibdd_db

# Ключ подписи JWT-токенов. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Почта для оповещений (необязательно). Если SMTP_USER/SMTP_PASSWORD пустые,
# письма просто не отправляются, остальное работает.
# Для Gmail нужен «пароль приложения», а не пароль от аккаунта.
# Сервер и порт задавать не обязательно: если их нет, выбираются по домену SMTP_USER
# (gmail.com: smtp.gmail.com:587, иначе smtp.yandex.ru:465). Для другого почтового сервиса:
# SMTP_SERVER=smtp.mail.ru
# SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Как часто (в секундах) симулятор «видит» разыскиваемую машину. По умолчанию 60.
# Для демонстрации удобно поставить 10.
DETECTION_INTERVAL_SECONDS=60

# Файл с тестовыми сотрудниками для seed.py (логины и пароли лежат там, а не в коде).
# Создайте его из шаблона:  cp seed_users.example.json seed_users.json
# Путь указывается относительно папки backend или абсолютный.
SEED_USERS_FILE=seed_users.json
