# Настройки для запуска в Docker (docker compose).
# Скопируйте файл:   copy .env.example .env     (Linux/Mac: cp .env.example .env)
# и поменяйте значения. Файл .env содержит секреты и в git не попадает.

# --- База данных ---
# Пароль root для MySQL в контейнере. Используйте только буквы и цифры:
# символы @ : / # % ломают адрес подключения.
MYSQL_ROOT_PASSWORD=change-me-db-password
MYSQL_DATABASE=gibdd_db

# --- Безопасность ---
# Ключ подписи токенов входа. Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-secret-key
# Общий секрет сервиса ГИБДД и сервиса камер: по нему они узнают друг друга.
# Только латинские буквы и цифры. Сгенерировать: python -c "import secrets; print(secrets.token_hex(16))"
SERVICE_TOKEN=change-me-service-token

# --- Сервис камер ---
# Как часто камеры «видят» автомобиль из списка розыска, секунд. Для демонстрации поставьте 10.
CAMERA_INTERVAL_SECONDS=60
# Разрешить ручную фиксацию (POST /v1/detections). В боевой системе отключается значением false.
ENABLE_MANUAL_DETECTIONS=true

# --- Оповещения ---
# Пауза после ответа сотрудника: новое оповещение по тому же автомобилю не раньше, чем через столько секунд.
# Пока сотрудник не ответил, повторных оповещений нет в любом случае. Для демонстрации поставьте 20.
ALERT_COOLDOWN_SECONDS=120
# Часовой пояс, в котором показываются дата и время оповещений
APP_TIMEZONE=Europe/Moscow
# Через сколько миллисекунд после «Принято» сайт спрашивает «Автомобиль задержан?»
FOUND_PROMPT_DELAY_MS=60000

# --- Почта (необязательно) ---
SMTP_USER=
SMTP_PASSWORD=
# SMTP_SERVER=
# SMTP_PORT=

# --- Прочее ---
# Заполнять базу тестовыми данными при старте backend (1 = да). Запуск безопасно повторять.
RUN_SEED=1
